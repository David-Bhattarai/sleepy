    "## 🤖 Step 2: Load Trained Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Emotion labels\n",
    "EMOTIONS = ['angry', 'disgust', 'fear', 'happy', 'neutral', 'sad', 'surprise']\n",
    "\n",
    "# Model paths to try\n",
    "model_paths = [\n",
    "    'server/high_accuracy_emotion_model.h5',\n",
    "    'high_accuracy_emotion_model.h5',\n",
    "    'server/emotion_model.h5',\n",
    "    'emotion_model.h5',\n",
    "    'fer2013_emotion_model.h5'\n",
    "]\n",
    "\n",
    "# Load model\n",
    "model = None\n",
    "model_path = None\n",
    "\n",
    "for path in model_paths:\n",
    "    if os.path.exists(path):\n",
    "        try:\n",
    "            model = load_model(path, compile=False)\n",
    "            model.compile(\n",
    "                optimizer='adam',\n",
    "                loss='categorical_crossentropy',\n",
    "                metrics=['accuracy']\n",
    "            )\n",
    "            model_path = path\n",
    "            print(f\"✅ Model loaded: {path}\")\n",
    "            break\n",
    "        except Exception as e:\n",
    "            print(f\"⚠️ Failed to load {path}: {e}\")\n",
    "            continue\n",
    "\n",
    "if model is None:\n",
    "    print(\"❌ No trained model found!\")\n",
    "    print(\"Please train the model first using: python train_high_accuracy_fer2013.py\")\n",
    "else:\n",
    "    print(f\"\\n📊 Model Summary:\")\n",
    "    print(f\"Total parameters: {model.count_params():,}\")\n",
    "    print(f\"Input shape: {model.input_shape}\")\n",
    "    print(f\"Output shape: {model.output_shape}\")\n",
    "    \n",
    "    # Load metadata if available\n",
    "    metadata_path = model_path.replace('.h5', '_metadata.json')\n",
    "    if os.path.exists(metadata_path):\n",
    "        with open(metadata_path, 'r') as f:\n",
    "            metadata = json.load(f)\n",
    "            print(f\"\\n📈 Model Metadata:\")\n",
    "            print(f\"Dataset: {metadata.get('dataset', 'N/A')}\")\n",
    "            print(f\"Test Accuracy: {metadata.get('test_accuracy', 0)*100:.2f}%\")\n",
    "            print(f\"Training Date: {metadata.get('training_date', 'N/A')}\")"
   ]
