    "def save_predictions_to_csv(results_list, output_file='predictions.csv'):\n",
    "    \"\"\"\n",
    "    Save prediction results to CSV file\n",
    "    \n",
    "    Args:\n",
    "        results_list: List of prediction results\n",
    "        output_file: Output CSV filename\n",
    "    \"\"\"\n",
    "    if not results_list:\n",
    "        print(\"❌ No results to save\")\n",
    "        return\n",
    "    \n",
    "    # Create DataFrame\n",
    "    data = []\n",
    "    for result in results_list:\n",
    "        row = {\n",
    "            'filename': result.get('filename', 'unknown'),\n",
    "            'dominant_emotion': result['dominant_emotion'],\n",
    "            'confidence': result['confidence']\n",
    "        }\n",
    "        # Add all emotion probabilities\n",
    "        for emotion, prob in result['all_emotions'].items():\n",
    "            row[f'{emotion}_prob'] = prob\n",
    "        data.append(row)\n",
    "    \n",
    "    df = pd.DataFrame(data)\n",
    "    df.to_csv(output_file, index=False)\n",
    "    \n",
    "    print(f\"✅ Predictions saved to: {output_file}\")\n",
    "    print(f\"Total records: {len(df)}\")\n",
    "    return df\n",
    "\n",
    "print(\"✅ CSV export function ready!\")\n",
    "print(\"Usage: save_predictions_to_csv(results_list, 'output.csv')\")"
   ]
