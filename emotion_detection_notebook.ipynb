   "source": [
    "def process_multiple_images(image_folder):\n",
    "    \"\"\"\n",
    "    Process multiple images from a folder\n",
    "    \n",
    "    Args:\n",
    "        image_folder: Path to folder containing images\n",
    "    \"\"\"\n",
    "    if not os.path.exists(image_folder):\n",
    "        print(f\"❌ Folder not found: {image_folder}\")\n",
    "        return\n",
    "    \n",
    "    # Get all image files\n",
    "    image_extensions = ['.jpg', '.jpeg', '.png', '.bmp']\n",
    "    image_files = [f for f in os.listdir(image_folder) \n",
    "                   if os.path.splitext(f)[1].lower() in image_extensions]\n",
    "    \n",
    "    if len(image_files) == 0:\n",
    "        print(f\"❌ No images found in {image_folder}\")\n",
    "        return\n",
    "    \n",
    "    print(f\"📁 Found {len(image_files)} images\")\n",
    "    print(f\"🔍 Processing...\\n\")\n",
    "    \n",
    "    results_list = []\n",
    "    \n",
    "    for img_file in image_files:\n",
    "        img_path = os.path.join(image_folder, img_file)\n",
    "        try:\n",
    "            results = predict_emotion(img_path, model)\n",
    "            results['filename'] = img_file\n",
    "            results_list.append(results)\n",
    "            print(f\"✅ {img_file:30s} → {results['dominant_emotion']:10s} ({results['confidence']:.1f}%)\")\n",
    "        except Exception as e:\n",
    "            print(f\"❌ {img_file:30s} → Error: {e}\")\n",
    "    \n",
    "    # Summary\n",
    "    print(f\"\\n📊 Summary:\")\n",
    "    emotion_counts = {}\n",
    "    for result in results_list:\n",
    "        emotion = result['dominant_emotion']\n",
    "        emotion_counts[emotion] = emotion_counts.get(emotion, 0) + 1\n",
    "    \n",
    "    for emotion, count in sorted(emotion_counts.items(), key=lambda x: x[1], reverse=True):\n",
    "        percentage = (count / len(results_list)) * 100\n",
    "        print(f\"  {emotion:10s}: {count:3d} images ({percentage:5.1f}%)\")\n",
    "    \n",
    "    return results_list\n",
    "\n",
    "# Example usage\n",
    "# results = process_multiple_images('path/to/image/folder')\n",
    "print(\"✅ Batch processing function ready!\")\n",
    "print(\"Usage: results = process_multiple_images('path/to/folder')\")"
   ]
