   "source": [
    "def webcam_emotion_detection(duration=30):\n",
    "    \"\"\"\n",
    "    Real-time emotion detection from webcam\n",
    "    \n",
    "    Args:\n",
    "        duration: Duration in seconds (default: 30)\n",
    "    \n",
    "    Note: Press 'q' to quit early\n",
    "    \"\"\"\n",
    "    print(f\"🎥 Starting webcam emotion detection...\")\n",
    "    print(f\"Duration: {duration} seconds\")\n",
    "    print(f\"Press 'q' to quit\\n\")\n",
    "    \n",
    "    # Initialize webcam\n",
    "    cap = cv2.VideoCapture(0)\n",
    "    \n",
    "    if not cap.isOpened():\n",
    "        print(\"❌ Could not open webcam\")\n",
    "        return\n",
    "    \n",
    "    # Face detector\n",
    "    face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')\n",
    "    \n",
    "    import time\n",
    "    start_time = time.time()\n",
    "    frame_count = 0\n",
    "    \n",
    "    while True:\n",
    "        # Check duration\n",
    "        if time.time() - start_time > duration:\n",
    "            break\n",
    "        \n",
    "        # Read frame\n",
    "        ret, frame = cap.read()\n",
    "        if not ret:\n",
    "            break\n",
    "        \n",
    "        frame_count += 1\n",
    "        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n",
    "        \n",
    "        # Detect faces\n",
    "        faces = face_cascade.detectMultiScale(gray, 1.3, 5)\n",
    "        \n",
    "        for (x, y, w, h) in faces:\n",
    "            # Extract face\n",
    "            face_gray = gray[y:y+h, x:x+w]\n",
    "            \n",
    "            # Preprocess\n",
    "            face_resized = cv2.resize(face_gray, (48, 48))\n",
    "            face_equalized = cv2.equalizeHist(face_resized)\n",
    "            face_normalized = face_equalized.astype('float32') / 255.0\n",
    "            face_final = face_normalized.reshape(1, 48, 48, 1)\n",
    "            \n",
    "            # Predict\n",
    "            predictions = model.predict(face_final, verbose=0)\n",
    "            emotion_idx = np.argmax(predictions[0])\n",
    "            emotion = EMOTIONS[emotion_idx]\n",
    "            confidence = predictions[0][emotion_idx] * 100\n",
    "            \n",
    "            # Draw rectangle\n",
    "            cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)\n",
    "            \n",
    "            # Draw emotion text\n",
    "            text = f\"{emotion}: {confidence:.1f}%\"\n",
    "            cv2.putText(frame, text, (x, y-10), cv2.FONT_HERSHEY_SIMPLEX, \n",
    "                       0.9, (0, 255, 0), 2)\n",
    "        \n",
    "        # Display frame\n",
    "        cv2.imshow('Emotion Detection', frame)\n",
    "        \n",
    "        # Check for 'q' key\n",
    "        if cv2.waitKey(1) & 0xFF == ord('q'):\n",
    "            break\n",
    "    \n",
    "    # Cleanup\n",
    "    cap.release()\n",
    "    cv2.destroyAllWindows()\n",
    "    \n",
    "    elapsed = time.time() - start_time\n",
    "    fps = frame_count / elapsed\n",
    "    \n",
    "    print(f\"\\n✅ Webcam detection completed!\")\n",
    "    print(f\"Frames processed: {frame_count}\")\n",
    "    print(f\"Duration: {elapsed:.1f} seconds\")\n",
    "    print(f\"FPS: {fps:.1f}\")\n",
    "\n",
    "# Run webcam detection\n",
    "# Uncomment to use:\n",
    "# webcam_emotion_detection(duration=30)\n",
    "\n",
    "print(\"✅ Webcam detection function ready!\")\n",
    "print(\"Usage: webcam_emotion_detection(duration=30)\")"
   ]
  },
